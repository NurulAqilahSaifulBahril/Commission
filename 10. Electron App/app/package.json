{
  "name": "commission-portal",
  "version": "0.2.0",
  "description": "Commission Portal — native window for the Finance Commission Dashboard",
  "main": "main.js",
  "author": "Nurul Aqilah Saiful Bahril",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "me.eternalgy.commission.portal",
    "productName": "CommissionDashboard",
    "files": [
      "main.js",
      "loading.html",
      "assets/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.finance"
    }
  }
}
