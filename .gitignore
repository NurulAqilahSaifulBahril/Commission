# Secrets — never commit tokens
.env
**/.env
**/pg_proxy_token.txt
**/.pg_proxy_token
**/pg_proxy_token*.txt

# Local dashboard database (password hashes, audit history).
# The .backup-* copies hold exactly the same thing — this repo is public.
#
# MATCH EVERY SQLite FILE, not just the exact name. "**/dashboard.db" was the
# rule here and it looked sufficient, but Windows writes a machine-suffixed
# copy -- dashboard-DESKTOP-QV69BG0.db -- which the pattern does not match.
# That file was committed to this public repository carrying six password
# hashes, 26 login records, 147 audit entries and 91 agent rows. Nothing
# warned; it simply was not ignored. No .db in this project is ever meant to
# be tracked, so the rule is now the broad one and the specific lines below
# are kept only to say what they are.
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.backup*
**/dashboard.db
**/dashboard*.db

# Database backups — contain password hashes and full audit history
/backups/

# Logs — can contain agent names and payout figures from stack traces
**/dashboard.log
**/dashboard-*.log
10. Electron App/sync/mirror.log

# Dashboard working directory: computed cache + generated commission packs
8. Web Dashboard/data/

# Release build output (recreated by tools/build_package.py)
/dist/

# Downloaded embeddable-Python zip, cached so repeat builds skip the download
/.cache/

# Python
**/.venv/
**/__pycache__/
**/*.pyc
**/5. _py_cache/

# Generated reports (re-run scripts to recreate)
**/output/
**/Finance Output/
**/2. Output/
**/4. data/reports/
**/4. data/nfp_commission_report.*


# Electron app (10. Electron App/app)
**/node_modules/
10. Electron App/app/dist/
10. Electron App/app/renderer/supabase.js
10. Electron App/app/config.json
10. Electron App/sync/*.log
